amends "@com.github.actions/Workflow.pkl"

import "@com.github.actions/catalog.pkl"
import "@com.github.actions/Step.pkl"

local artifactName = "pdfmeta-macos-universal"
// both architectures in one binary; SwiftPM puts a multi-arch build under .build/apple
local buildArgs = "-c release --arch arm64 --arch x86_64"

name = "Build pdfmeta"

on {
  workflow_dispatch {}
  push {
    branches {
      "**"
    }
    tags {
      "v*"
    }
  }
}

permissions {
  contents = "read"
}

// a newer push to the same branch makes the older run pointless
concurrency {
  group = "${{ github.workflow }}-${{ github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  ["build"] {
    name = "Test and build"
    // PDFKit only exists on macOS
    `runs-on` = "macos-26"
    `timeout-minutes` = 30
    steps {
      (catalog.`actions/checkout@v6`) {
        with {
          `fetch-depth` = 1
        }
      }
      (Step) {
        name = "Show toolchain"
        run = "swift --version"
      }
      (Step) {
        name = "Test"
        // the suite takes about a second; a hard limit stops a runaway test
        // from eating the runner's disk with swap, as once happened locally
        `timeout-minutes` = 10
        run = "swift test"
      }
      (Step) {
        name = "Build universal binary"
        run =
          """
          swift build \(buildArgs)
          bin="$(swift build \(buildArgs) --show-bin-path)/pdfmeta"
          lipo -info "$bin"
          "$bin" --help
          mkdir -p dist
          tar -czf "dist/\(artifactName).tar.gz" -C "$(dirname "$bin")" pdfmeta
          """
      }
      (catalog.`actions/upload-artifact@v7`) {
        with {
          name = artifactName
          pathList {
            "dist/\(artifactName).tar.gz"
          }
          `if-no-files-found` = "error"
        }
      }
    }
  }
  ["release"] {
    name = "Create release"
    `if` = "startsWith(github.ref, 'refs/tags/v')"
    needs = "build"
    `runs-on` = "ubuntu-slim"
    permissions {
      contents = "write"
    }
    steps {
      (catalog.`actions/download-artifact@v8`) {
        with {
          name = artifactName
          path = "dist"
        }
      }
      (Step) {
        name = "Publish"
        env {
          ["GH_TOKEN"] = "${{ github.token }}"
        }
        run =
          """
          gh release create "$GITHUB_REF_NAME" dist/*.tar.gz \\
            --repo "$GITHUB_REPOSITORY" --generate-notes
          """
      }
    }
  }
}
