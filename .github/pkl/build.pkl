amends "@com.github.actions/Workflow.pkl"

import "@com.github.actions/catalog.pkl"
import "@com.github.actions/Step.pkl"

import "actions/MiseAction.pkl"

// artifacts are named <prefix>-<arch>: arm64, x86_64, universal
local artifactPrefix = "pdfmeta-macos"

name = "Build pdfmeta"

on {
  workflow_dispatch {}
  // release.yml calls this only when no build of the tagged commit exists
  workflow_call {}
  // branches only: a tag reuses the artifacts of its commit's build (see release.yml)
  push {
    branches {
      "**"
    }
  }
}

permissions {
  contents = "read"
}

// a newer push to the same branch makes the older run pointless
concurrency {
  group = "${{ github.workflow }}-${{ github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  // PDFKit only exists on macOS, so the matrix is macOS-only. Each architecture builds
  // and tests on a native runner, so the binary shipped is the one that was tested.
  ["build"] {
    name = "Test and build (${{ matrix.arch }})"
    `runs-on` = "${{ matrix.runner }}"
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        ["include"] {
          new Dynamic {
            arch = "arm64"
            runner = "macos-26"
          }
          new Dynamic {
            arch = "x86_64"
            runner = "macos-15-intel"
          }
        }
      }
    }
    steps {
      (catalog.`actions/checkout@v6`) {
        with {
          `fetch-depth` = 1
        }
      }
      // only the tasks are needed; Swift comes with the runner's Xcode
      (MiseAction) {
        with {
          install = false
        }
      }
      (Step) {
        name = "Show toolchain"
        run = "swift --version"
      }
      (Step) {
        name = "Test"
        // the task kills the suite itself after 60 seconds; this covers the build before it
        `timeout-minutes` = 10
        run = "mise run test"
      }
      (Step) {
        name = "Build"
        run =
          """
          mise run build --arch ${{ matrix.arch }}
          bin="$(swift build -c release --arch ${{ matrix.arch }} --show-bin-path)/pdfmeta"
          lipo -info "$bin"
          "$bin" --help
          mkdir -p dist
          tar -czf "dist/\(artifactPrefix)-${{ matrix.arch }}.tar.gz" -C "$(dirname "$bin")" pdfmeta
          """
      }
      (catalog.`actions/upload-artifact@v7`) {
        with {
          name = "\(artifactPrefix)-${{ matrix.arch }}"
          pathList {
            "dist/\(artifactPrefix)-${{ matrix.arch }}.tar.gz"
          }
          `if-no-files-found` = "error"
        }
      }
    }
  }
  // joins the two tested binaries rather than compiling a third time
  ["universal"] {
    name = "Universal binary"
    needs = "build"
    `runs-on` = "macos-26"
    steps {
      (catalog.`actions/download-artifact@v8`) {
        with {
          pattern = "\(artifactPrefix)-*"
          path = "dist"
          `merge-multiple` = true
        }
      }
      (Step) {
        name = "Merge with lipo"
        run =
          """
          mkdir -p arm64 x86_64
          tar -xzf "dist/\(artifactPrefix)-arm64.tar.gz" -C arm64
          tar -xzf "dist/\(artifactPrefix)-x86_64.tar.gz" -C x86_64
          lipo -create arm64/pdfmeta x86_64/pdfmeta -output pdfmeta
          lipo -info pdfmeta
          ./pdfmeta --help
          tar -czf "dist/\(artifactPrefix)-universal.tar.gz" pdfmeta
          """
      }
      (catalog.`actions/upload-artifact@v7`) {
        with {
          name = "\(artifactPrefix)-universal"
          pathList {
            "dist/\(artifactPrefix)-universal.tar.gz"
          }
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
